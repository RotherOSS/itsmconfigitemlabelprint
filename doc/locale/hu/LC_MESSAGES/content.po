msgstr "Frontend::Agent::ModuleRegistration::MainMenu"

#: ../../content/index.rst:119
msgid ""
"Frontend::Navigation###AgentITSMConfigItemLabelPrint###003-"
"AgentITSMConfigItemLabelPrint"
msgstr ""
"Frontend::Navigation###AgentITSMConfigItemLabelPrint###003-"
"AgentITSMConfigItemLabelPrint"

